{
	"presets": [
		[
			"@babel/preset-env",
			{
				"modules": false,
				"targets": {
					"browsers": [
						"> 1%",
						"last 2 versions",
						"not ie <= 10"
					]
				}
			}
		]
	],
	"plugins": [
		"@babel/plugin-transform-runtime",
		[
			"transform-imports",
			{
				"vuetify": {
					"transform":
						"vuetify/es5/components/${member}",
					"preventFullImport": true
				}
			}
		]
	],
	"env": {
		"test": {
			"presets": [
				"@babel/preset-env"
			]
		}
	}
}
